/* pages/about/about.wxss — Stripe 风格 */
.page {
  min-height: 100vh;
  background: var(--canvas);
  padding: 28rpx 24rpx;
}

.b-card {
  background: var(--canvas);
  border: 1px solid var(--hairline);
  border-radius: var(--r-lg);
  padding: 36rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

/* Brand card */
.brand-card {
  position: relative;
  overflow: hidden;
}
.brand-card::after {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--primary-subdued), var(--primary));
}
.brand-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.brand-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  display: flex;
  align-items: center;
  justify-content: center;
}
.brand-icon-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
}
.brand-name {
  font-size: 32rpx;
  font-weight: 400;
  color: var(--ink);
}

/* Subscription */
.sub-card {
  background: var(--canvas);
  border-color: var(--hairline);
  position: relative;
  overflow: hidden;
  text-align: center;
}
.sub-card::after {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--primary-subdued), var(--primary));
}
.sub-badge {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: var(--primary);
  color: #fff;
  border-radius: var(--r-pill);
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--ink);
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: -0.4rpx;
}

.card-desc {
  font-size: 24rpx;
  color: var(--ink-secondary);
  line-height: 1.5;
  font-weight: 300;
  display: block;
  margin-bottom: 20rpx;
}

.sub-form {
  display: flex;
  gap: 12rpx;
  position: relative;
}

.sub-input {
  flex: 1;
  padding: 20rpx 24rpx;
  border: 1px solid var(--hairline);
  border-radius: var(--r-lg);
  font-size: 24rpx;
  font-weight: 300;
  background: var(--canvas);
}

.sub-btn {
  padding: 16rpx 40rpx;
  background: var(--primary);
  color: #fff;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.4;
}

.sub-btn[disabled] { opacity: 0.5; }

.sub-msg {
  font-size: 22rpx;
  display: block;
  margin-top: 16rpx;
  min-height: 36rpx;
}

.success { color: var(--green); }
.error { color: var(--red); }

/* Info list */
.info-list {
  margin-top: 16rpx;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1px solid var(--hairline);
}
.info-row:last-child { border-bottom: none; }

.info-label {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink-mute);
}

.info-value {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink);
}

.tag-blue {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: rgba(83,58,253,.06);
  color: var(--primary);
  border-radius: var(--r-pill);
  font-size: 22rpx;
  font-weight: 400;
}

/* Link card */
.link-card {
  padding: 0;
  overflow: hidden;
}

.site-btn {
  width: 100%;
  padding: 32rpx;
  background: var(--canvas);
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 400;
  text-align: center;
  border: none;
  line-height: 1;
  border-radius: var(--r-lg);
}

.link-hover { background: var(--canvas-soft); }

.footer-text {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-dim);
  margin: 40rpx 0;
}
