<!-- pages/history/history.wxml — Stripe 风格 -->
<view class="page">
  <view class="page-header">
    <text class="page-title">历史数据</text>
    <button class="btn-primary" bindtap="onDownload">下载 CSV</button>
  </view>

  <!-- 币种切换 -->
  <view class="currency-tabs">
    <view wx:for="{{currencies}}" wx:key="key"
      class="currency-tab {{currency === item.key ? 'active' : ''}}"
      data-key="{{item.key}}" bindtap="onCurrencyTap">
      {{item.label}}
    </view>
  </view>

  <!-- Date Filter — B站 pill style -->
  <view class="date-filter">
    <view class="date-toggle" bindtap="onToggleDateRange">
      <text class="date-toggle-label">📅 自定义日期范围</text>
      <text class="toggle-arrow {{showDateRange ? 'arrow-up' : ''}}">▾</text>
    </view>
    <view class="date-panel {{showDateRange ? 'open' : ''}}">
      <picker class="date-picker" mode="date" value="{{startDateVal}}" end="{{endDateVal}}" bindchange="onStartDateChange">
        <view class="picker-btn">{{startDateVal || '开始日期'}}</view>
      </picker>
      <text class="date-sep">—</text>
      <picker class="date-picker" mode="date" value="{{endDateVal}}" start="{{startDateVal}}" bindchange="onEndDateChange">
        <view class="picker-btn">{{endDateVal || '结束日期'}}</view>
      </picker>
      <button class="query-btn" bindtap="onDateQuery">查询</button>
    </view>
  </view>

  <scroll-view scroll-y class="table-scroll">
    <view class="table">
      <view class="table-row header">
        <text class="cell c1">日期</text>
        <text class="cell c2">买入</text>
        <text class="cell c3">钞买入</text>
        <text class="cell c4">卖出</text>
        <text class="cell c5">钞卖出</text>
        <text class="cell c6">折算</text>
      </view>
      <view class="table-row" wx:for="{{list}}" wx:key="date">
        <text class="cell c1">{{item.date}}</text>
        <text class="cell c2 p-buy">{{item.buyRate}}</text>
        <text class="cell c3">{{item.cashBuyRate}}</text>
        <text class="cell c4 p-sell">{{item.sellRate}}</text>
        <text class="cell c5">{{item.cashSellRate}}</text>
        <text class="cell c6 mid">{{item.midRate}}</text>
      </view>
    </view>
  </scroll-view>
</view>