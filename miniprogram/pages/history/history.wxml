<!-- pages/history/history.wxml -->
<view class="page">
  <view class="table-header">
    <text class="table-title">最近30条数据</text>
    <button class="download-btn" bindtap="onDownload">下载CSV</button>
  </view>

  <scroll-view scroll-y class="table-scroll">
    <view class="table">
      <view class="table-row header">
        <text class="cell col-date">日期</text>
        <text class="cell col-buy">买入</text>
        <text class="cell col-sell">卖出</text>
        <text class="cell col-mid">折算价</text>
        <text class="cell col-time">时间</text>
      </view>
      <view class="table-row" wx:for="{{list}}" wx:key="date">
        <text class="cell col-date">{{item.date}}</text>
        <text class="cell col-buy rate">{{item.buyRate}}</text>
        <text class="cell col-sell rate">{{item.sellRate}}</text>
        <text class="cell col-mid rate mid">{{item.midRate}}</text>
        <text class="cell col-time">{{item.publishTime.slice(-8)}}</text>
      </view>
    </view>
  </scroll-view>
</view>