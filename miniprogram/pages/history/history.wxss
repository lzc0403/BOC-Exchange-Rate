/* pages/history/history.wxss */
.page {
  min-height: 100vh;
  background: #FAFAF8;
  padding: 30rpx;
}

.table-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.table-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3436;
}

.download-btn {
  padding: 12rpx 30rpx;
  background: #2D3436;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.2;
}

.table-scroll {
  max-height: calc(100vh - 260rpx);
}

.table {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.03);
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid #F5F3EF;
}

.table-row.header {
  background: #F5F3EF;
  position: sticky;
  top: 0;
}

.table-row:last-child { border-bottom: none; }

.cell {
  padding: 22rpx 14rpx;
  font-size: 26rpx;
  color: #555;
  box-sizing: border-box;
  white-space: nowrap;
}

.col-date { width: 24%; }
.col-buy { width: 19%; text-align: right; }
.col-sell { width: 19%; text-align: right; }
.col-mid { width: 19%; text-align: right; }
.col-time { width: 19%; text-align: right; }

.header .cell {
  font-size: 22rpx;
  color: #888;
  font-weight: 500;
}

.rate { font-family: 'Menlo', monospace; font-weight: 600; }
.mid { color: #C4956A; }