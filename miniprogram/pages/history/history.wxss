/* pages/history/history.wxss — B站风格 */
.page {
  min-height: 100vh;
  background: var(--canvas);
  padding: 28rpx 24rpx;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #000;
}

.btn-pink {
  padding: 12rpx 32rpx;
  background: var(--bili-pink);
  color: #fff;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(251,114,153,0.25);
}

/* Date Filter */
.date-filter {
  background: #fff;
  border: 2rpx solid var(--border);
  border-radius: var(--r-lg);
  margin-bottom: 16rpx;
  overflow: hidden;
}

.date-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-muted);
  background: #fff;
}

.toggle-arrow {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--ink-dim);
  transition: transform 0.3s;
}

.toggle-arrow.arrow-up {
  transform: rotate(180deg);
}

.date-panel {
  display: none;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx 24rpx;
  flex-wrap: wrap;
}

.date-panel.open {
  display: flex;
}

.date-picker {
  flex: 1;
  min-width: 200rpx;
}

.picker-btn {
  padding: 16rpx 20rpx;
  border: 2rpx solid var(--border-mid);
  border-radius: var(--r-pill);
  font-size: 24rpx;
  font-weight: 600;
  color: #000;
  text-align: center;
  background: var(--surface-1);
}

.date-sep {
  font-size: 24rpx;
  color: var(--ink-dim);
}

.query-btn {
  padding: 14rpx 40rpx;
  background: var(--bili-pink);
  color: #fff;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  box-shadow: 0 4rpx 12rpx rgba(251,114,153,0.25);
}

.table-scroll {
  max-height: calc(100vh - 420rpx);
}

.table {
  background: #fff;
  border: 2rpx solid var(--border);
  border-radius: var(--r-lg);
  overflow: hidden;
}

.table-row {
  display: flex;
  border-bottom: 2rpx solid var(--border);
}

.table-row.header {
  background: var(--surface-1);
  position: sticky;
  top: 0;
}

.table-row:last-child { border-bottom: none; }

.cell {
  padding: 20rpx 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-soft);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
  text-align: right;
}

.c1 { width: 22%; text-align: left; color: var(--ink-muted); font-weight: 500; }
.c2 { width: 16%; }
.c3 { width: 16%; }
.c4 { width: 16%; }
.c5 { width: 16%; }
.c6 { width: 14%; color: var(--bili-pink); font-weight: 700; }

.p-buy { color: var(--bili-blue); font-weight: 600; }
.p-sell { color: var(--bili-yellow); font-weight: 600; }

.header .cell {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--ink-dim);
  text-align: center;
}

.header .c1 { text-align: left; }