/* pages/history/history.wxss — Stripe 风格 */
.page {
  min-height: 100vh;
  background: var(--canvas);
  padding: 28rpx 24rpx;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: 300;
  color: var(--ink);
  letter-spacing: -0.4rpx;
}

.btn-primary {
  padding: 12rpx 32rpx;
  background: var(--ink);
  color: #fff;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.2;
  border: none;
  box-shadow: var(--shadow-card);
}

/* Date Filter */
.date-filter {
  background: var(--canvas);
  border: 1px solid var(--hairline);
  border-radius: var(--r-lg);
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.date-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink-mute);
  background: var(--canvas);
}

.toggle-arrow {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--ink-dim);
  transition: transform 0.3s;
}

.toggle-arrow.arrow-up {
  transform: rotate(180deg);
}

.date-panel {
  display: none;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx 24rpx;
  flex-wrap: wrap;
}

.date-panel.open {
  display: flex;
}

.date-picker {
  flex: 1;
  min-width: 200rpx;
}

.picker-btn {
  padding: 16rpx 20rpx;
  border: 1px solid var(--hairline);
  border-radius: var(--r-lg);
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink);
  text-align: center;
  background: var(--canvas);
}

.date-sep {
  font-size: 24rpx;
  color: var(--ink-dim);
}

.query-btn {
  padding: 14rpx 40rpx;
  background: var(--primary);
  color: #fff;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.2;
}

.table-scroll {
  max-height: calc(100vh - 420rpx);
}

.table {
  background: var(--canvas);
  border: 1px solid var(--hairline);
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.table-row {
  display: flex;
  border-bottom: 1px solid var(--hairline);
}

.table-row.header {
  background: var(--canvas-soft);
  position: sticky;
  top: 0;
}

.table-row:last-child { border-bottom: none; }

.cell {
  padding: 20rpx 10rpx;
  font-size: 24rpx;
  font-weight: 300;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
  text-align: right;
  font-feature-settings: "ss01", "tnum";
}

.c1 { width: 22%; text-align: left; color: var(--ink-mute); font-weight: 400; }
.c2 { width: 16%; }
.c3 { width: 16%; }
.c4 { width: 16%; }
.c5 { width: 16%; }
.c6 { width: 14%; color: var(--primary); font-weight: 400; }

.p-buy { color: var(--green); font-weight: 400; }
.p-sell { color: var(--red); font-weight: 400; }

.header .cell {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--ink-mute);
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.header .c1 { text-align: left; }

/* 币种切换 */
.currency-tabs {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.currency-tab {
  padding: 10rpx 28rpx;
  border-radius: var(--r-pill);
  font-size: 26rpx;
  font-weight: 400;
  color: var(--primary);
  background: var(--canvas);
  border: 1px solid var(--primary);
  transition: all .15s;
}
.currency-tab.active {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
}
