/* pages/history/history.wxss */
.page {
  min-height: 100vh;
  background: #FAFAF8;
  padding: 24rpx;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3436;
}

.download-btn {
  padding: 10rpx 28rpx;
  background: #2D3436;
  color: #fff;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.2;
}

.table-scroll {
  max-height: calc(100vh - 220rpx);
}

.table {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.03);
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid #F5F3EF;
}

.table-row.header {
  background: #F5F3EF;
  position: sticky;
  top: 0;
}

.table-row:last-child { border-bottom: none; }

.cell {
  padding: 18rpx 10rpx;
  font-size: 22rpx;
  color: #555;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
  text-align: right;
}

.c1 { width: 22%; text-align: left; }
.c2 { width: 16%; }
.c3 { width: 16%; }
.c4 { width: 16%; }
.c5 { width: 16%; }
.c6 { width: 14%; color: #C4956A; font-weight: 600; }

.header .cell {
  font-size: 20rpx;
  color: #888;
  font-weight: 500;
  text-align: center;
}

.header .c1 { text-align: left; }