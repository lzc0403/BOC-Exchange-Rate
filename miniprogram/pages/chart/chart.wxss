/* pages/chart/chart.wxss */
.page {
  min-height: 100vh;
  background: #FAFAF8;
  padding: 30rpx;
}

.time-filter {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
  flex-wrap: wrap;
}

.time-btn {
  padding: 12rpx 28rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #6B6B6B;
  transition: all 0.3s;
}

.time-btn.active {
  background: #2D3436;
  color: #fff;
  border-color: #2D3436;
}

.chart-box {
  width: 100%;
  height: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 30rpx rgba(0,0,0,0.04);
  position: relative;
}

#lineCanvas {
  width: 100%;
  height: 100%;
}

.empty-tip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 28rpx;
  color: #9A9A9A;
}

.legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 30rpx;
  flex-wrap: wrap;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #6B6B6B;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.legend-dot.dashed {
  width: 28rpx;
  height: 4rpx;
  border-radius: 2rpx;
}

/* 币种切换 */
.currency-tabs {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.currency-tab {
  padding: 10rpx 28rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: #533afd;
  background: #fff;
  border: 1px solid #533afd;
  transition: all .15s;
}
.currency-tab.active {
  background: #533afd;
  color: #fff;
  border-color: #533afd;
}