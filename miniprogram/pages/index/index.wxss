/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  background: #FAFAF8;
  padding-bottom: 20rpx;
}

.hero {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
  background: linear-gradient(180deg, #F5F3EF 0%, #FAFAF8 100%);
}

.hero-subtitle {
  font-size: 26rpx;
  color: #6B6B6B;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
}

.hero-title {
  font-size: 80rpx;
  font-weight: 700;
  color: #2D3436;
  line-height: 1.1;
}

.hero-unit { font-size: 28rpx; font-weight: 400; color: #9A9A9A; }
.hero-label { font-size: 24rpx; color: #6B6B6B; display: block; margin-top: 12rpx; }
.hero-date { font-size: 22rpx; color: #C4956A; display: block; margin-top: 10rpx; }

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.stat-card {
  width: calc(50% - 8rpx);
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.stat-card:active { transform: scale(0.97); }

.bg-buy { background: linear-gradient(135deg, #E8F8F0, #F0FFF4); }
.bg-sell { background: linear-gradient(135deg, #FDE8E8, #FFF5F5); }
.bg-mid { background: linear-gradient(135deg, #F5F0EB, #FAF5F0); }
.bg-info { background: linear-gradient(135deg, #2D3436, #3D4446); }
.bg-info .stat-label { color: rgba(255,255,255,0.6); }
.bg-info .stat-value { color: #fff; }

.stat-label { font-size: 22rpx; color: #6B6B6B; display: block; margin-bottom: 8rpx; }
.stat-value { font-size: 44rpx; font-weight: 700; color: #2D3436; display: block; letter-spacing: -1rpx; }
.stat-trend { font-size: 20rpx; display: block; margin-top: 6rpx; }
.trend-up { color: #E74C3C; }
.trend-down { color: #27AE60; }
.trend-flat { color: #999; }

/* Chart Section */
.chart-section {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 20rpx rgba(0,0,0,0.04);
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
}

.chart-filter {
  display: flex;
  gap: 12rpx;
}

.filter-btn {
  padding: 8rpx 24rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #6B6B6B;
}

.filter-btn.active {
  background: #2D3436;
  color: #fff;
  border-color: #2D3436;
}

.chart-box {
  width: 100%;
  height: 520rpx;
  position: relative;
}

#lineCanvas { width: 100%; height: 100%; }

.empty-tip {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  font-size: 26rpx;
  color: #9A9A9A;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #6B6B6B;
}

.legend-line {
  width: 28rpx;
  height: 4rpx;
  border-radius: 2rpx;
}

.legend-line.dashed {
  background: transparent;
  border-top: 4rpx dashed;
}