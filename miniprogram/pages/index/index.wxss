/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  background: #FAFAF8;
  padding-bottom: 20rpx;
}

.hero {
  padding: 80rpx 40rpx 60rpx;
  text-align: center;
  background: linear-gradient(180deg, #F5F3EF 0%, #FAFAF8 100%);
}

.hero-subtitle {
  font-size: 28rpx;
  color: #6B6B6B;
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.hero-title {
  font-size: 96rpx;
  font-weight: 700;
  color: #2D3436;
  line-height: 1.1;
}

.hero-unit {
  font-size: 32rpx;
  font-weight: 400;
  color: #9A9A9A;
}

.hero-label {
  font-size: 26rpx;
  color: #6B6B6B;
  display: block;
  margin-top: 16rpx;
}

.hero-date {
  font-size: 22rpx;
  color: #C4956A;
  display: block;
  margin-top: 12rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 30rpx;
}

.stat-card {
  width: calc(50% - 10rpx);
  padding: 32rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  transition: transform 0.3s;
}

.stat-card:active {
  transform: scale(0.97);
}

.bg-buy {
  background: linear-gradient(135deg, #E8F8F0, #F0FFF4);
}

.bg-sell {
  background: linear-gradient(135deg, #FDE8E8, #FFF5F5);
}

.bg-mid {
  background: linear-gradient(135deg, #F5F0EB, #FAF5F0);
}

.bg-info {
  background: linear-gradient(135deg, #2D3436, #3D4446);
}

.bg-info .stat-label { color: rgba(255,255,255,0.6); }
.bg-info .stat-value { color: #fff; }

.stat-label {
  font-size: 24rpx;
  color: #6B6B6B;
  display: block;
  margin-bottom: 12rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #2D3436;
  display: block;
  letter-spacing: -1rpx;
}

.stat-trend {
  font-size: 22rpx;
  display: block;
  margin-top: 8rpx;
}

.trend-up { color: #E74C3C; }
.trend-down { color: #27AE60; }
.trend-flat { color: #999; }