/* pages/index/index.wxss — Stripe 风格 */
.page {
  min-height: 100vh;
  background: var(--canvas);
}

/* Hero — gradient mesh */
.hero {
  padding: 56rpx 30rpx 48rpx;
  background:
    radial-gradient(46% 65% at 8% 30%, rgba(245,233,212,.6) 0%, transparent 65%),
    radial-gradient(40% 60% at 48% 38%, rgba(214,200,255,.5) 0%, transparent 60%),
    radial-gradient(38% 55% at 80% 30%, rgba(249,107,238,.25) 0%, transparent 65%);
  text-align: center;
  position: relative;
  overflow: hidden;
}
.hero-subtitle {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink-mute);
  display: inline-block;
  margin-bottom: 20rpx;
  position: relative;
}
.hero-subtitle strong {
  color: var(--primary);
  font-weight: 500;
}
.hero-title {
  font-size: 68rpx;
  font-weight: 300;
  color: var(--ink);
  letter-spacing: -2rpx;
  line-height: 1.05;
  display: block;
  margin: 8rpx 0;
}
.hero-unit {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--ink-mute);
}
.hero-label {
  font-size: 26rpx;
  color: var(--ink-secondary);
  font-weight: 400;
  display: block;
  margin-top: 10rpx;
}
.hero-date {
  font-size: 24rpx;
  color: var(--ink-dim);
  font-weight: 300;
  display: block;
  margin-top: 16rpx;
}

/* Stats — Stripe card */
.stats-grid {
  padding: 0 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.stat-card {
  background: var(--canvas);
  border: 1px solid var(--hairline);
  border-radius: var(--r-lg);
  padding: 28rpx 24rpx;
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.stat-label {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-mute);
  letter-spacing: 0.04em;
  display: block;
}
.stat-value {
  font-size: 44rpx;
  font-weight: 300;
  color: var(--ink);
  letter-spacing: -1rpx;
  line-height: 1;
  display: block;
  font-feature-settings: "ss01", "tnum";
}
.stat-value.green { color: var(--green); }
.stat-value.red { color: var(--red); }
.stat-value.purple { color: var(--primary); }
.stat-trend {
  font-size: 22rpx;
  font-weight: 400;
  display: block;
}
.trend-up { color: var(--red); }
.trend-down { color: var(--green); }
.trend-flat { color: var(--ink-dim); }

/* Chart section — Stripe card */
.chart-section {
  margin: 0 24rpx 24rpx;
  background: var(--canvas-soft);
  border: 1px solid var(--hairline);
  border-radius: var(--r-xl);
  overflow: hidden;
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}
.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.chart-title {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--ink-secondary);
  letter-spacing: -0.2rpx;
}
.chart-filter {
  display: flex;
  gap: 10rpx;
}
.filter-btn {
  padding: 8rpx 24rpx;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink-secondary);
  background: transparent;
  border: 1px solid var(--hairline);
  transition: all .15s;
}
.filter-btn.active {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
}
.chart-box {
  width: 100%;
  height: 400rpx;
  position: relative;
  padding: 8rpx 0;
}
#lineCanvas {
  width: 100%;
  height: 100%;
}
.empty-tip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 26rpx;
  color: var(--ink-mute);
}
.chart-legend {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1px solid var(--hairline);
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-mute);
}
.legend-line {
  width: 24rpx;
  height: 4rpx;
  border-radius: 2rpx;
}
.legend-line.dashed {
  border-top: 4rpx dashed;
  height: 0;
  width: 24rpx;
  background: transparent !important;
}
