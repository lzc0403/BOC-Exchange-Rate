/* pages/index/index.wxss — B站风格 */
.page {
  min-height: 100vh;
  background: var(--canvas);
}

/* Hero */
.hero {
  padding: 48rpx 30rpx 40rpx;
  background: linear-gradient(180deg, var(--canvas-tint) 0%, var(--canvas) 70%);
  text-align: center;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--bili-pink-soft) 0%, transparent 60%);
  top: -200rpx;
  right: -100rpx;
  pointer-events: none;
}
.hero-subtitle {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--bili-pink);
  display: inline-block;
  padding: 10rpx 28rpx;
  background: var(--canvas);
  border: 2rpx solid rgba(251,114,153,0.15);
  border-radius: var(--r-pill);
  margin-bottom: 20rpx;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(251,114,153,0.08);
}
.hero-subtitle::before {
  content: '';
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--bili-pink);
  margin-right: 10rpx;
  vertical-align: middle;
  box-shadow: 0 0 8rpx var(--bili-pink);
}
.hero-title {
  font-size: 72rpx;
  font-weight: 800;
  color: #000;
  letter-spacing: -2rpx;
  line-height: 1.08;
  display: block;
  margin: 8rpx 0;
}
.hero-unit {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink-muted);
}
.hero-label {
  font-size: 26rpx;
  color: var(--ink-muted);
  display: block;
  margin-top: 10rpx;
}
.hero-date {
  font-size: 24rpx;
  color: var(--ink-dim);
  display: block;
  margin-top: 16rpx;
}

/* Stats — B站视频卡片风格 */
.stats-grid {
  padding: 0 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.stat-card {
  background: #fff;
  border: 2rpx solid var(--border);
  border-radius: var(--r-lg);
  padding: 28rpx 24rpx;
  transition: all .2s;
  box-shadow: none;
}
.stat-card:nth-child(1) { border-color: var(--bili-pink-soft); }
.stat-card:nth-child(2) { border-color: var(--bili-blue-soft); }
.stat-card:nth-child(3) { border-color: rgba(255, 193, 0, 0.15); }
.stat-card:nth-child(4) { border-color: rgba(157, 94, 227, 0.12); }
.stat-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink-dim);
  display: block;
  margin-bottom: 8rpx;
}
.stat-value {
  font-size: 44rpx;
  font-weight: 800;
  color: #000;
  letter-spacing: -1rpx;
  line-height: 1;
  display: block;
}
.stat-value.green { color: var(--bili-green); }
.stat-value.red { color: var(--bili-pink); }
.stat-value.purple { color: var(--bili-purple); }
.stat-trend {
  font-size: 22rpx;
  display: block;
  margin-top: 8rpx;
}
.trend-up { color: var(--bili-pink); }
.trend-down { color: var(--bili-green); }
.trend-flat { color: var(--ink-dim); }

/* Chart section */
.chart-section {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border: 2rpx solid var(--border);
  border-radius: var(--r-lg);
  overflow: hidden;
  padding: 24rpx;
}
.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.chart-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #000;
}
.chart-filter {
  display: flex;
  gap: 10rpx;
}
.filter-btn {
  padding: 8rpx 24rpx;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-muted);
  background: var(--surface-1);
  border: 2rpx solid transparent;
  transition: all .15s;
}
.filter-btn.active {
  background: var(--bili-pink);
  color: #fff;
  border-color: var(--bili-pink);
  box-shadow: 0 4rpx 12rpx rgba(251,114,153,0.25);
}
.chart-box {
  width: 100%;
  height: 400rpx;
  position: relative;
}
#lineCanvas {
  width: 100%;
  height: 100%;
}
.empty-tip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 26rpx;
  color: var(--ink-dim);
}
.chart-legend {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--border);
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink-muted);
}
.legend-line {
  width: 24rpx;
  height: 6rpx;
  border-radius: 3rpx;
}
.legend-line.dashed { border-top: 4rpx dashed; height: 0; width: 24rpx; background: transparent !important; }