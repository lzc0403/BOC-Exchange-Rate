<!-- pages/index/index.wxml — Stripe 风格 -->
<view class="page">
  <!-- Hero -->
  <view class="hero">
    <text class="hero-subtitle">中国银行官方外汇牌价</text>
    <text class="hero-title">{{latestRate}}<text class="hero-unit"> CNY</text></text>
    <text class="hero-label">{{currencyLabel}} · 中行折算价</text>
    <text class="hero-date">数据更新: {{lastUpdate}}</text>
    <!-- 币种切换 -->
    <view class="currency-tabs">
      <view wx:for="{{currencies}}" wx:key="key"
        class="currency-tab {{currency === item.key ? 'active' : ''}}"
        data-key="{{item.key}}" bindtap="onCurrencyTap">
        {{item.label}}
      </view>
    </view>
  </view>

  <!-- Stats -->
  <view class="stats-grid">
    <view class="stat-card">
      <text class="stat-label">现汇买入</text>
      <text class="stat-value green">{{buyRate}}</text>
      <text class="stat-trend {{buyTrendClass}}">{{buyTrend}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-label">现汇卖出</text>
      <text class="stat-value red">{{sellRate}}</text>
      <text class="stat-trend {{sellTrendClass}}">{{sellTrend}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-label">中行折算</text>
      <text class="stat-value purple">{{midRate}}</text>
      <text class="stat-trend {{midTrendClass}}">{{midTrend}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-label">累计数据</text>
      <text class="stat-value" style="color:var(--ink);font-size:38rpx;">{{totalDays}}</text>
      <text class="stat-trend" style="color:var(--ink-dim);font-size:20rpx;">{{dataRange}}</text>
    </view>
  </view>

  <!-- Chart -->
  <view class="chart-section">
    <view class="chart-header">
      <text class="chart-title">汇率走势</text>
      <view class="chart-filter">
        <view class="filter-btn {{activeDays === 7 ? 'active' : ''}}" data-days="7" bindtap="onFilter">近7天</view>
        <view class="filter-btn {{activeDays === 30 ? 'active' : ''}}" data-days="30" bindtap="onFilter">近30天</view>
      </view>
    </view>
    <view class="chart-box">
      <canvas id="lineCanvas" type="2d" style="width:100%;height:100%;"></canvas>
      <view class="empty-tip" wx:if="{{empty}}">所选时间段暂无数据</view>
    </view>
    <view class="chart-legend">
      <view class="legend-item">
        <view class="legend-line" style="background:var(--primary);"></view>
        <text>折算价</text>
      </view>
      <view class="legend-item">
        <view class="legend-line dashed" style="border-color:var(--green);"></view>
        <text>买入价</text>
      </view>
      <view class="legend-item">
        <view class="legend-line dashed" style="border-color:var(--red);"></view>
        <text>卖出价</text>
      </view>
    </view>
  </view>
</view>