/* B站风格全局样式 */
page {
  --bili-pink: #FB7299;
  --bili-pink-deep: #E85B83;
  --bili-pink-soft: rgba(251, 114, 153, 0.1);
  --bili-blue: #00A1D6;
  --bili-blue-soft: rgba(0, 161, 214, 0.1);
  --bili-yellow: #FFC100;
  --bili-purple: #9D5EE3;
  --bili-green: #6BCB77;
  --canvas: #ffffff;
  --canvas-tint: #FFF6F9;
  --surface-1: #FDF2F6;
  --surface-2: #FCE4EC;
  --ink: #18191c;
  --ink-soft: #424650;
  --ink-muted: #61666d;
  --ink-dim: #9499a0;
  --border: #f1f2f3;
  --border-mid: #e3e5e7;
  --shadow-card: 0 4rpx 16rpx rgba(251, 114, 153, 0.1);
  --r-sm: 6rpx;
  --r-md: 10rpx;
  --r-lg: 16rpx;
  --r-xl: 24rpx;
  --r-pill: 999rpx;
  --font: "Inter", "Noto Sans SC", -apple-system, "PingFang SC", sans-serif;
  background: var(--canvas);
  font-family: var(--font);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.6;
}